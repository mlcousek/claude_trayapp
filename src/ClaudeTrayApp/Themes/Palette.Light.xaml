<!-- Light palette: same roles as the dark one, tuned so text and status colours keep at least 4.5:1 on the surface. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="SurfaceColor">#FAF9F5</Color>
    <Color x:Key="SurfaceElevatedColor">#FFFFFF</Color>
    <Color x:Key="SurfaceTranslucentColor">#E6FAF9F5</Color>
    <Color x:Key="HairlineColor">#E4E1DA</Color>
    <Color x:Key="TextPrimaryColor">#1F1E1D</Color>
    <Color x:Key="TextSecondaryColor">#6B6860</Color>
    <Color x:Key="AccentColor">#C4633F</Color>
    <Color x:Key="OkColor">#C4633F</Color>
    <Color x:Key="SuccessColor">#5C8543</Color>
    <Color x:Key="WarnColor">#9C7420</Color>
    <Color x:Key="DangerColor">#A8392F</Color>
    <Color x:Key="Chart1Color">#C4633F</Color>
    <Color x:Key="Chart2Color">#3F73A8</Color>
    <Color x:Key="Chart3Color">#5C8543</Color>
    <Color x:Key="Chart4Color">#9C7420</Color>
    <Color x:Key="Chart5Color">#6B6860</Color>
</ResourceDictionary>
