<Window x:Class="ClaudeTrayApp.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Claude Usage Tray"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="{StaticResource FontSizeBody}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AutomationProperties.Name="About Claude Usage Tray">
    <Border Padding="28,20,28,20">
        <StackPanel>
            <TextBox x:Name="AboutText"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     AutomationProperties.Name="About text" />
            <Button x:Name="CloseButton"
                    Style="{StaticResource FlyoutButton}"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0"
                    Content="_Close"
                    IsDefault="True"
                    IsCancel="True"
                    AutomationProperties.Name="Close about" />
        </StackPanel>
    </Border>
</Window>
